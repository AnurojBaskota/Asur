// ASUR catalog + inventory schema.
// Prices are stored as whole rupees (Int). Stock is tracked per variant,
// and every change is recorded in StockMovement for an audit trail.

generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres.
//   DATABASE_URL – pooled connection (pgbouncer, port 6543) used by the app at runtime
//   DIRECT_URL   – direct connection (port 5432) used by `prisma migrate`
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  sizeChart   String? // JSON: { columns: string[], rows: string[][], note?: string }
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String         @default("")
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  collection       String?
  material         String         @default("")
  careInstructions String         @default("")
  fit              String         @default("Regular") // Slim | Regular | Oversized | Compression
  weight           String?
  gender           String         @default("Unisex") // Men | Women | Unisex
  tags             String         @default("") // comma separated
  featured         Boolean        @default(false)
  isNew            Boolean        @default(false)
  status           String         @default("draft") // draft | active | archived
  images           ProductImage[]
  variants         Variant[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0) // position 0 is the cover image

  @@index([productId])
}

model Variant {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String          @unique
  barcode           String          @unique // EAN-13
  size              String
  colorName         String
  colorHex          String
  price             Int
  salePrice         Int?
  costPrice         Int             @default(0)
  stock             Int             @default(0)
  lowStockThreshold Int             @default(5)
  movements         StockMovement[]
  orderItems        OrderItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([productId, size, colorName])
  @@index([productId])
}

model StockMovement {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Int // +restock / -sale etc.
  balance   Int // stock after this movement
  type      String // initial | restock | sale | return | damage | correction
  note      String?
  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String       @id @default(cuid())
  number        Int          @unique @default(autoincrement()) // shown as AS-10001 (sequence starts at 10001)
  publicToken   String       @unique // lets the customer view their confirmation page
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status        String       @default("pending") // pending | confirmed | processing | ready_for_dispatch | dispatched | delivered | cancelled | returned
  paymentMethod String       @default("cod") // cod
  paymentStatus String       @default("pending") // pending | paid | refunded
  subtotal      Int
  shippingFee   Int
  total         Int
  // Shipping address snapshot
  shipName      String
  shipPhone     String
  shipAddress   String
  shipCity      String
  shipArea      String?
  shipNotes     String?
  items         OrderItem[]
  events        OrderEvent[]
  dispatchedAt  DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Snapshot so the order stays correct if the product changes later
  productName String
  sku         String
  barcode     String
  size        String
  colorName   String
  colorHex    String
  image       String?
  unitPrice   Int
  quantity    Int
  total       Int
  scannedQty  Int      @default(0) // dispatch verification

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // created | status | payment | note
  message   String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------------------
// Store content & settings
// ---------------------------------------------------------------------------

/// Key/value JSON settings (shipping rules, homepage sections, contact…).
model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

/// Editable content pages: shipping, returns, privacy, terms, contact…
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String   @default("") // Markdown-lite: blank line = paragraph, "## " = heading, "- " = bullet
  published Boolean  @default(true)
  showInFooter Boolean @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
